# Soccer Intelligence Engine — Environment Variables
# Copy to .env for local development
# Set these in Render Dashboard → Environment for production

# ── Required: free key from football-data.org ────────────────────────────────
FOOTBALL_DATA_API_KEY=your_free_key_here

# ── Optional: TheOddsAPI (500 req/month free at theoddsapi.com) ──────────────
THE_ODDS_API_KEY=

# ── Optional: API-Football (lineups, injuries) ────────────────────────────────
API_FOOTBALL_KEY=

# ── Optional: SportMonks (xG, lineups) ───────────────────────────────────────
SPORTMONKS_KEY=

# ── Storage (auto-set on Render) ─────────────────────────────────────────────
CACHE_DIR=/tmp/soccer_cache
MODEL_DIR=/tmp/soccer_models
PORT=8000
